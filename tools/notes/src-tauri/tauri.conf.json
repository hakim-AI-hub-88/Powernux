{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "powernux-notes",
  "version": "1.0.0",
  "identifier": "com.ivar-ai.powernux.notes",
  "build": {
    "beforeBuildCommand": "cd ../.. && npm run build:notes-ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notes",
        "width": 1040,
        "height": 680,
        "minWidth": 720,
        "minHeight": 460,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}
