{
  "name": "powernux",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:clipboard-ui": "vite build --config tools/clipboard/vite.config.ts",
    "package:clipboard": "bash tools/package-tool.sh clipboard",
    "package:window-pin": "bash tools/package-tool.sh window-pin",
    "package:voice-typing": "bash tools/package-tool.sh voice-typing",
    "package:focus-mode": "bash tools/package-tool.sh focus-mode",
    "package:projects": "bash tools/package-tool.sh projects",
    "package:file-organizer": "bash tools/package-tool.sh file-organizer",
    "package:screenshot": "bash tools/package-tool.sh screenshot",
    "package:ai-face": "bash tools/package-tool.sh ai-face",
    "build:notes-ui": "vite build --config tools/notes/vite.config.ts",
    "package:notes": "bash tools/package-tool.sh notes",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
